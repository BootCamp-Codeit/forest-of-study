# Copy to .env for local dev. On Render: add these in Environment tab.

DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
PEPPER_SECRET=your-random-pepper-secret
JWT_SECRET=your-random-jwt-secret

# Demo seed (npm run db:seed) — all studies share this password
# DEMO_PASSWORD=qwert12345!

# Optional
JWT_EXPIRES=1h
LOGTAIL_TOKEN=
NODE_ENV=production
